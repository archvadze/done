{
  "expo": {
    "name": "ღვაწლი ხელოვნება",
    "slug": "acumen-craft-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "acumencraft",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B5A2B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.acumencraft.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "This app needs access to camera to capture and upload artwork photos.",
        "NSPhotoLibraryUsageDescription": "This app needs access to photo library to select and upload artwork images.",
        "NSMicrophoneUsageDescription": "This app may need microphone access for video content.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "acumencraft",
            "CFBundleURLSchemes": [
              "acumencraft"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8B5A2B"
      },
      "package": "com.acumencraft.mobile",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "acumencraft.com"
            },
            {
              "scheme": "acumencraft"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Acumen Craft to access your photos to upload artwork.",
          "cameraPermission": "Allow Acumen Craft to access your camera to take photos of artwork."
        }
      ],
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "defaultChannel": "default"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "acumen-craft-mobile-prod"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/acumen-craft-mobile-prod"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}